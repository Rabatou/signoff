# Copy nothing by hand: `python setup.py` writes .env for you.
# Then add ONE of these if you want an LLM agent (otherwise rules-based mode runs):
LLM_PROVIDER=auto          # auto | anthropic | openai | rules
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible providers (Groq, Gemini, Ollama...):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
